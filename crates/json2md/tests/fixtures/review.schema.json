{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "sections", "verdict"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "verdict": { "enum": ["approve", "request changes"] }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["name", "findings"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["rule", "result", "details"],
      "additionalProperties": false,
      "properties": {
        "rule": { "type": "string" },
        "result": { "enum": ["pass", "fail"] },
        "details": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
